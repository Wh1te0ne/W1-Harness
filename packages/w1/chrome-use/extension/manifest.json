{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.2.4",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "W1 Chrome",
    "default_icon": {
      "16": "app-icon-16.png",
      "32": "app-icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  },
  "icons": {
    "16": "app-icon-16.png",
    "32": "app-icon-32.png",
    "48": "app-icon-48.png",
    "128": "app-icon-128.png"
  }
}
