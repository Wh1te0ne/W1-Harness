{
  "name": "@w1h/remote",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "W1 encrypted remote companion transport and standalone NAS relay",
  "files": ["lib", "host.mjs", "host.d.mts", "crypto.mjs", "client.mjs", "ui-entry.mjs",
    "presentation.mjs", "presentation.d.mts", "qr.mjs", "qr.d.mts", "README.md"],
  "exports": {
    "./host": {
      "types": "./host.d.mts",
      "default": "./host.mjs"
    },
    "./qr": {
      "types": "./qr.d.mts",
      "default": "./qr.mjs"
    },
    "./presentation": {
      "types": "./presentation.d.mts",
      "default": "./presentation.mjs"
    },
    ".": "./ui-entry.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node relay.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:desktop-ui": "node build-desktop-ui.mjs"
  },
  "dependencies": {
    "ws": "8.21.3",
    "qrcode-generator": "2.0.4"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
